# Optional. Enables blueprint analysis and admin AI verification.
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini

# Optional. Enables centralized commercial auth/access instead of local demo storage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_REPORT_BUCKET=discrepancy-report-attachments
VITE_SUPABASE_PUBLIC_REPORT_ATTACHMENTS=false

# Optional. Used by the blocked-access screen when Supabase Edge Functions are configured.
VITE_STRIPE_INDIVIDUAL_PRICE_ID=
VITE_STRIPE_COMPANY_PRICE_ID=
# JSON object keyed by "customerTierId:calculatorTierId".
# Example value:
# {"individual:calc_35_plus":{"priceId":"price_...","priceLabel":"$50/mo","seatLimit":1,"billingQuantity":1},"company_0_10:calc_35_plus":{"priceId":"price_...","priceLabel":"$50/mo","seatLimit":10,"billingQuantity":1}}
VITE_STRIPE_PRICE_MATRIX_JSON=

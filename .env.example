# Optional. Enables blueprint analysis and admin AI verification.
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini

# Optional. Enables centralized commercial auth/access instead of local demo storage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_REPORT_BUCKET=discrepancy-report-attachments
VITE_SUPABASE_PUBLIC_REPORT_ATTACHMENTS=false

# Optional. Google Play Billing base plan used by the Android app.
VITE_GOOGLE_PLAY_BASE_PLAN_ID=monthly

# Optional. Used by Stripe Checkout when Supabase Edge Functions are configured.
VITE_STRIPE_PRICE_INDIVIDUAL_6_15=
VITE_STRIPE_PRICE_INDIVIDUAL_16_25=
VITE_STRIPE_PRICE_INDIVIDUAL_26_35=
VITE_STRIPE_PRICE_INDIVIDUAL_36_PLUS=
VITE_STRIPE_PRICE_COMPANY_0_10=
VITE_STRIPE_PRICE_COMPANY_11_20=
VITE_STRIPE_PRICE_COMPANY_UNLIMITED=

# Optional JSON object keyed by final plan key.
# Example value:
# {"individual_36_plus":{"priceId":"price_...","priceLabel":"$50/mo"},"company_0_10":{"priceId":"price_...","priceLabel":"$400/mo"}}
VITE_STRIPE_PRICE_MATRIX_JSON=

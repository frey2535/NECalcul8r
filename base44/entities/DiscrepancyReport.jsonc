{
  "name": "DiscrepancyReport",
  "type": "object",
  "properties": {
    "calculator_id": {
      "type": "string",
      "description": "Calculator ID (e.g. 'voltage_drop')"
    },
    "calculator_name": {
      "type": "string",
      "description": "Display name of the calculator"
    },
    "nec_year": {
      "type": "string",
      "enum": [
        "2017",
        "2020"
      ],
      "description": "NEC year selected when report was submitted"
    },
    "article_ref": {
      "type": "string",
      "description": "NEC article/table reference reported (e.g. 'Ch.9 Table 8')"
    },
    "current_result": {
      "type": "string",
      "description": "What the app currently shows"
    },
    "expected_result": {
      "type": "string",
      "description": "What the user believes the correct result should be"
    },
    "explanation": {
      "type": "string",
      "description": "User's explanation of the discrepancy"
    },
    "inputs": {
      "type": "string",
      "description": "JSON snapshot of calculator input values at time of report"
    },
    "outputs": {
      "type": "string",
      "description": "JSON snapshot of calculator output values at time of report"
    },
    "app_version": {
      "type": "string",
      "description": "App version when the report was submitted"
    },
    "file_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional screenshot/photo URLs"
    },
    "contact_email": {
      "type": "string",
      "description": "Optional contact email for follow-up"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "reviewed",
        "accepted",
        "rejected"
      ],
      "default": "open",
      "description": "Admin review status"
    },
    "admin_notes": {
      "type": "string",
      "description": "Internal notes from admin review"
    }
  },
  "required": [
    "calculator_id",
    "calculator_name",
    "nec_year",
    "explanation"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}